PORT=8080
MONGO_DB=mongodb://127.0.0.1:27017/?replicaSet=rs0&directConnection=true
MONGO_DB_NAME=crikoptions_local
JWT_SECRET=change_me
TOKEN_HOURS=24
ADMIN_EMAILS=admin@example.com
# Google sign-in: OAuth 2.0 Web client ID (same value as the frontend's
# NEXT_PUBLIC_GOOGLE_CLIENT_ID). Leave empty to disable the /auth/google endpoint.
GOOGLE_CLIENT_ID=
CHAT_ENABLED=false
ALLOWED_ORIGINS=http://localhost:3000,https://cricoptions.vercel.app

# Match simulator (disabled locally to prevent accidental production writes)
SIMULATOR_ENABLED=false
SIMULATOR_AUTO_START=false
SIMULATOR_AUTO_LOOP=false
# Reset built-in simulator matches on API boot. Set false to resume persisted state.
SIMULATOR_RESET_ON_BOOT=false
SIMULATOR_DATA_DIR=./data/simulator
# Seconds between balls; overrides CSV delay_sec when set (default 15 in CSV)
SIMULATOR_DEFAULT_INTERVAL_SEC=4
# Standby instances retry the distributed lock at this interval.
SIMULATOR_AUTO_START_RETRY_SEC=15

# CricLive (https://cricketliveapi.com/api-docs). Keep the token in your
# deployment secret store. Auth is a bearer token sent in the Authorization
# header. Modes: off | shadow | live.
CRICLIVE_MODE=off
CRICLIVE_API_TOKEN=
CRICLIVE_BASE_URL=https://cricketliveapi.com/api/v1
CRICLIVE_HTTP_TIMEOUT=15s
# The real ceiling: CricLive meters calls per calendar day.
CRICLIVE_DAILY_REQUEST_LIMIT=5000
# Burst limiter only; must stay high enough to poll a live match.
CRICLIVE_HOURLY_REQUEST_LIMIT=900
CRICLIVE_QUOTA_RESERVE_PERCENT=20
CRICLIVE_MAX_CONCURRENCY=4
CRICLIVE_DISCOVERY_INTERVAL=60s
CRICLIVE_FIXTURE_SYNC_INTERVAL=6h
CRICLIVE_MIN_POLL_INTERVAL=6s
CRICLIVE_MAX_POLL_INTERVAL=10s
CRICLIVE_BREAK_INTERVAL=60s
CRICLIVE_PREMATCH_INTERVAL=15m
CRICLIVE_FINALIZING_INTERVAL=15s
CRICLIVE_LEASE_TTL=30s
CRICLIVE_STALE_MINIMUM=60s
CRICLIVE_ACTIVE_FREEZE_TIMEOUT=5m
CRICLIVE_MATCH_FINALIZATION_HOLD=120s
CRICLIVE_INNINGS_FINALIZATION_HOLD=60s
CRICLIVE_RAW_PAYLOAD_TTL=2h
# Ignored when CRICLIVE_MODE=live (live always fast-polls). Used for shadow only.
CRICLIVE_FAST_POLLING_ENABLED=true
CRICLIVE_ALLOW_LIVE_CORRECTIONS=false
CRICLIVE_ALLOW_MID_MATCH_LIVE_ADMISSION=false

# --- Sportmonks (replaced by CricLive; kept for reference only) ---
# These are no longer read by the application.
# SPORTMONKS_MODE=off
# SPORTMONKS_API_TOKEN=
# SPORTMONKS_BASE_URL=https://cricket.sportmonks.com/api/v2.0
# SPORTMONKS_METADATA_SYNC_INTERVAL=24h
